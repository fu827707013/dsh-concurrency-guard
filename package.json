{
  "name": "dsh-concurrency-guard",
  "version": "1.3.5",
  "description": "DSH 并发请求监控与门闩：挂钩 llm/stream 瀑布，统计全部在途模型请求并按来源分类（主会话/子代理/插件/压缩/标题）与会话活跃聚合，达到上限 FIFO 排队，防止并发超限被供应商锁号；提供 WebUI 实时面板（含历史清理）、HTTP JSON 端点、状态文件与 concurrency_status 工具。",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "concurrency",
    "monitor",
    "rate-limit",
    "semaphore",
    "webui-panel"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/fu827707013/dsh-concurrency-guard.git"
  },
  "homepage": "https://github.com/fu827707013/dsh-concurrency-guard",
  "bugs": {
    "url": "https://github.com/fu827707013/dsh-concurrency-guard/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "screenshots.json",
    "img",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/gate.test.mjs",
    "pack": "npm pack"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}